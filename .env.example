# Execução
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173

# Caminhos de dados (relativos à raiz do repositório por padrão)
INPUT_DIR=a_data/a_input
OUTPUT_DIR=a_data/b_output
GOLDEN_RECORDS_PATH=a_data/c_golden_records/golden_records.csv

# Upload e processamento de documentos
MAX_UPLOAD_SIZE_MB=20
OCR_LANGUAGE=por
OCR_DPI=300
NATIVE_TEXT_MIN_CHARS=80

# Provider de LLM
LLM_PROVIDER=gemini
LLM_BASIC_MODEL=gemini-3.5-flash-lite
LLM_STRONG_MODEL=gemini-3.8-flash
GEMINI_API_KEY=

# Persistência dos JSONs gerados
POSTGRES_DB=fintrace
POSTGRES_USER=fintrace
POSTGRES_PASSWORD=fintrace
DATABASE_URL=postgresql://fintrace:fintrace@localhost:5432/fintrace

# Frontend
VITE_API_BASE_URL=http://localhost:8000
