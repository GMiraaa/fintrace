# Artefatos de execução
*.log
*.tmp
a_data/a_input/uploads/
a_data/a_input/*.uploading
a_data/b_output/*.json.tmp

# Em saída, versiona somente os JSONs entregáveis do case.
a_data/b_output/*
!a_data/b_output/.gitkeep
!a_data/b_output/*.json

# Reprocessamentos recebem um sufixo hexadecimal e são artefatos locais.
a_data/b_output/*_[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json
